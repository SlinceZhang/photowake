# Copy this file to .env in the same directory before running docker compose.
# Update the values as needed for your environment.

# Reverse proxy
NGINX_PORT=8080

# Web application
WEB_PORT=3000
WEB_NODE_ENV=production
NEXT_PUBLIC_API_URL=/api

# API server
SERVER_PORT=3080
SERVER_NODE_ENV=production

# Optional development overrides
NEXT_PUBLIC_API_URL_DEV=http://localhost:3080/api
WEB_DEV_PORT=3001
SERVER_DEV_PORT=3081
