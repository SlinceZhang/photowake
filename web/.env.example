# Copy this file to .env.local (or .env.development) and adjust values for your environment.

# Base URL that the Next.js frontend uses when issuing API requests through axios.
# For local development, the backend listens on http://localhost:3080/api
NEXT_PUBLIC_API_URL=http://localhost:3080/api

# Optional override used when you want to target a different backend during development.
# Uncomment and update if you need to point to a staging API while running the local UI.
# NEXT_PUBLIC_API_URL_DEV=http://staging.example.com/api
